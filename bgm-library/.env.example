# 作者(アーティスト)検索補助をする場合のみ設定 (未設定でも動作するが検索ボタンが使えない)
# https://www.lastfm.jp/api/account/create で無料取得できる (Premium等の契約は不要)
# 注意: 魔王魂などのフリーBGM素材は商用配信されていないため基本的にヒットしない。
#       市販曲(J-POP等)を使う場合の検索補助として使える。
LASTFM_API_KEY=

# ポート番号
PORT=4000

# 待ち受けアドレス。既定は 0.0.0.0 で、同じLANの他端末からも管理画面を開ける
# (認証機構は無いので、信頼できるネットワークでのみ使うこと)。
# このPCからしか使わない場合は 127.0.0.1 にするとLANに露出しなくなる。
# HOST=0.0.0.0

# main.py --dir と同じフォルダを指すこと (音源ファイルの実体を保存する場所)
TRACKS_DIR=../tracks

# main.py --program と同じファイルを指すこと (行事の次第)
PROGRAM_FILE=../program.json

# YouTubeダウンロード機能に使う yt-dlp のコマンド名/パス (通常は変更不要)
# 要: pip install yt-dlp と ffmpeg のインストール
YT_DLP_CMD=yt-dlp

# ボーカル除去(Demucs)・音声変換(ffmpeg)で使うコマンド名/パス
# PYTHON_CMD は省略すると隣の venv (../venv) を自動検出する
# 要: (main.py と同じvenvで) pip install demucs
# PYTHON_CMD=
FFMPEG_CMD=ffmpeg

# ボーカル除去(Demucs)のモデル。既定は高品質な htdemucs_ft
# (4モデルアンサンブルで既定より高精度だが約4倍遅い)。速度優先なら htdemucs に。
# DEMUCS_MODEL=htdemucs_ft

# ボーカル除去の実行デバイス。省略すると起動時に自動検出する
# (NVIDIA GPU の cuda > Apple Silicon の mps > cpu の優先順)。
# 特定のデバイスに固定したい場合のみ cuda/mps/cpu のいずれかを指定
# DEMUCS_DEVICE=
